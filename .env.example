# Copy this file to .env for local runs. dotenvy loads it but never
# overrides a variable already set in the environment, so a real deployment's
# configuration always wins over a file that got shipped by accident.

# A Postgres connection string. otto-platform-server connects as this role,
# runs otto-tenant's migrations against it, and then verifies that role's
# tenant isolation before calling itself ready (see that binary's docs).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/otto_platform

# The public origin a browser sees, no trailing slash. REQUIRED, and there is
# deliberately no default: the OAuth issuer, the discovery document, every link
# the product hands out, and the WebAuthn relying party id (this URL's host)
# are all built from it. Production is https://savvagent.com.
#
# Changing the host invalidates every passkey ever registered, because a
# passkey is bound to its relying party id. Use a different value per
# environment rather than reusing one.
SAVVAGENT_PUBLIC_URL=http://localhost:8080

# 32 random bytes, base64. REQUIRED. Encrypts secrets at rest (today: the
# enterprise SSO connections' IdP client secrets, and each resource server's
# webhook signing secret). Generate with
#   openssl rand -base64 32
# Losing or changing it makes every stored secret unreadable.
SAVVAGENT_ENCRYPTION_KEY=

# Set only when a trusted proxy that OVERWRITES this header sits in front of
# the server, e.g. `fly-client-ip` on Fly.io. It keys per-IP rate limits and the
# audit trail. Leave unset otherwise: with no such proxy the header is whatever
# the caller typed, and a throttle keyed on it is worse than no throttle.
# SAVVAGENT_CLIENT_IP_HEADER=fly-client-ip
#
# Behind the optional Cloudflare Worker (docs/deploy/cloudflare.md), use
# `cf-connecting-ip` instead: Fly's own header then holds a Cloudflare address.
# SAVVAGENT_CLIENT_IP_HEADER=cf-connecting-ip

# Whether the resource servers (otto-factory, ...) are enforcing hard-stop
# plans. Reporting only: this server enforces nothing, it echoes this as
# `enforced` on GET /api/orgs/{org}/usage. Keep it equal to the resource
# servers' own setting. Defaults to false.
SAVVAGENT_ENFORCE_QUOTAS=false

# Set to 0/false to skip running migrations at startup (e.g. a deployment
# that migrates as a separate step ahead of a rolling restart). Defaults to
# true.
SAVVAGENT_RUN_MIGRATIONS=true

# Log verbosity, in tracing-subscriber's EnvFilter syntax. Defaults to "info".
RUST_LOG=info

# Directory holding the built console (web/build; /srv/console in the image).
# Set it to have this server also serve the console: prerendered pages, and the
# SPA shell (200.html, which must exist or the server refuses to start) for
# client-side routes. The self-hosted shape. Production sets it in fly.toml.
# Leave unset when a Cloudflare Worker serves the console instead.
# SAVVAGENT_STATIC_DIR=/srv/console

# Hosts that only redirect: comma-separated bare lowercase hostnames (no scheme,
# port or path). Empty by default, which redirects nothing. A request whose Host
# is one of them gets a 308 to SAVVAGENT_PUBLIC_URL plus the same path and
# query, for every method and path, before anything else runs. Production sets
# otto.savvagent.com, the pre-rebrand host. The server refuses to start if an
# entry is the public URL's own host.
# SAVVAGENT_REDIRECT_HOSTS=otto.savvagent.com

# Address to serve HTTP on. Defaults to 0.0.0.0:8080.
SAVVAGENT_BIND=127.0.0.1:8080

# "json" for structured logs (deployments); anything else is human-readable text.
SAVVAGENT_LOG_FORMAT=text

# Notification email (budget alerts). Both or neither: setting exactly one is a
# startup error. With neither, email is disabled, the server says so at boot,
# and messages wait in notification_outbox until both are set. Both are
# secrets: the URL carries the SMTP credentials (percent-encode any reserved
# characters in them). TLS is required (smtps://, or smtp:// with
# ?tls=required) except to a loopback host, e.g. a local mail catcher such as
# Mailpit:
# SAVVAGENT_SMTP_URL=smtp://localhost:1025
# SAVVAGENT_EMAIL_FROM=otto <alerts@localhost.test>
#
# A real provider:
# SAVVAGENT_SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# SAVVAGENT_EMAIL_FROM=otto <alerts@savvagent.com>

# Stripe billing. Both or neither: setting exactly one is a startup error.
# With neither, billing is disabled, the server says so at boot, the billing
# console routes report `billingEnabled: false` or answer 503
# billing_disabled, and so does the Stripe webhook. Both are secrets. Use
# test-mode values locally (the Stripe CLI's `stripe listen` prints a
# whsec_ for forwarding webhooks to http://localhost:8080/api/stripe/webhook).
# With both set, the server also runs `stripe sync` itself every 15 minutes;
# `otto-platform-server stripe sync` runs it now and needs only the key. See
# docs/deploy/fly.md#stripe-setup for the key's permissions and the events.
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Usage review threshold: the most of one meter an org may accrue in one UTC
# billing month before further events are held for operator review instead of
# billed (a runaway or compromised resource server cannot bill without limit).
# Held events are listed by `otto-platform-server usage held`. Default 1000000000000.
# SAVVAGENT_USAGE_HOLD_THRESHOLD=1000000000000
