# Copy this file to .env for local runs. dotenvy loads it but never
# overrides a variable already set in the environment, so a real deployment's
# configuration always wins over a file that got shipped by accident.

# A Postgres connection string. otto-platform-server connects as this role,
# runs otto-tenant's migrations against it, and then verifies that role's
# tenant isolation before calling itself ready (see that binary's docs).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/otto_platform

# The public origin a browser sees, no trailing slash. REQUIRED, and there is
# deliberately no default: the OAuth issuer, the discovery document, every link
# the product hands out, and the WebAuthn relying party id (this URL's host)
# are all built from it. Production is https://otto.savvagent.com.
#
# Changing the host invalidates every passkey ever registered, because a
# passkey is bound to its relying party id. Use a different value per
# environment rather than reusing one.
OTTO_PUBLIC_URL=http://localhost:8080

# 32 random bytes, base64. REQUIRED. Encrypts secrets at rest (today: the
# enterprise SSO connections' IdP client secrets, and each resource server's
# webhook signing secret). Generate with
#   openssl rand -base64 32
# Losing or changing it makes every stored secret unreadable.
OTTO_ENCRYPTION_KEY=

# Set only when a trusted proxy that OVERWRITES this header sits in front of
# the server, e.g. `fly-client-ip` on Fly.io. It keys per-IP rate limits and the
# audit trail. Leave unset otherwise: with no such proxy the header is whatever
# the caller typed, and a throttle keyed on it is worse than no throttle.
# OTTO_CLIENT_IP_HEADER=fly-client-ip

# Whether the resource servers (otto-factory, ...) are enforcing hard-stop
# plans. Reporting only: this server enforces nothing, it echoes this as
# `enforced` on GET /api/orgs/{org}/usage. Keep it equal to the resource
# servers' own setting. Defaults to false.
OTTO_ENFORCE_QUOTAS=false

# Set to 0/false to skip running migrations at startup (e.g. a deployment
# that migrates as a separate step ahead of a rolling restart). Defaults to
# true.
OTTO_RUN_MIGRATIONS=true

# Log verbosity, in tracing-subscriber's EnvFilter syntax. Defaults to "info".
RUST_LOG=info

# Address to serve HTTP on. Defaults to 0.0.0.0:8080.
OTTO_BIND=127.0.0.1:8080

# "json" for structured logs (deployments); anything else is human-readable text.
OTTO_LOG_FORMAT=text
